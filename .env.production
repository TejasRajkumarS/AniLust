# Production Environment Variables for GitHub Pages Deployment
# Copy these to GitHub Repository Settings > Secrets > Actions

# Backend API URL (deploy separately to Render/Railway/Fly.io)
# Example: https://anilust-backend.onrender.com
VITE_BACKEND_URL=

# Aniraku Backend for streaming (public API - may go offline)
VITE_ANIRAKU_BACKEND_URL=https://api.aniraku.tech

# Google Gemini API Key (optional - for AI insights)
VITE_GEMINI_API_KEY=

# Self-hosted aniwatch-api (optional - for episodes if not using Aniraku)
VITE_HIANIME_API_URL=