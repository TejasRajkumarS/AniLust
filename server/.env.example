# AniLust Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Security
# REQUIRED in production (NODE_ENV=production): the server refuses to boot
# with the built-in default. Use a random 32+ character secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# User accounts are stored in a JSON file at server/data/users.json
# (bcrypt password hashes — never commit; gitignored). Override the path:
# USERS_FILE=/var/lib/anilust/users.json

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Environment: development | production
NODE_ENV=development

# Optional: Enable debug mode (true/false)
# DEBUG=false
