# Frontend Environment Variables

# Aniraku Backend for streaming & metadata (public API - may go offline)
# For production reliability, self-host: https://github.com/Aniraku/Aniraku-Backend
VITE_ANIRAKU_BACKEND_URL=https://api.aniraku.tech

# Self-hosted aniwatch-api (optional — for episodes if not using Aniraku)
# Deploy from: https://github.com/ghoshRitesh12/aniwatch-api
VITE_HIANIME_API_URL=

# Google Gemini API Key (optional - only used for AI insight features)
VITE_GEMINI_API_KEY=