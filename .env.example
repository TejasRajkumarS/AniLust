# Frontend Environment Variables

# Self-hosted aniwatch-api (REQUIRED for episodes & streaming)
# Deploy from: https://github.com/ghoshRitesh12/aniwatch-api (or a maintained fork)
# Example: https://your-aniwatch-api.onrender.com
VITE_HIANIME_API_URL=

# Backend API URL (optional AniList proxy for production)
# Example: https://anilust-backend.herokuapp.com
# Leave empty to call AniList directly from the browser
VITE_BACKEND_URL=

# Google Gemini API Key (optional - only used for AI insight features)
VITE_GEMINI_API_KEY=
